# Connection used by the running app. Must be a NON-superuser role so row-level security applies.
DATABASE_URL=postgres://nutrihome_app:change-me@127.0.0.1:5433/nutrihome
# Owner/admin connection used only by `npm run migrate` (creates tables, policies and the app role).
MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:5433/nutrihome
# Password the migration sets for the app role (must match DATABASE_URL above).
APP_DB_PASSWORD=change-me
PORT=3000
NODE_ENV=development
# Set to 1 when running behind a reverse proxy that terminates HTTPS.
TRUST_PROXY=0
