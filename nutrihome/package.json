{
  "name": "nutrihome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NutriHome — تطبيق منزلي عربي لحساب السعرات والماكروز وتخطيط الوجبات والمخزون",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && node -e \"require('fs').cpSync('src/server/db/migrations','dist/server/server/db/migrations',{recursive:true})\"",
    "start": "node dist/server/server/index.js",
    "migrate": "tsx src/server/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/phase1.e2e.mjs",
    "migrate:prod": "node dist/server/server/db/migrate.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
